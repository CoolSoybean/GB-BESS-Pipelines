{
  "name": "gb-bess-pipelines",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist",
    "pages:deploy": "wrangler pages deploy dist --project-name gb-bess-pipelines",
    "worker:dev": "wrangler dev --config sync-worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config sync-worker/wrangler.toml",
    "db:local": "wrangler d1 migrations apply gb-bess-pipelines --local",
    "db:remote": "wrangler d1 migrations apply gb-bess-pipelines --remote",
    "lint": "oxlint src functions sync-worker"
  },
  "dependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "lucide-react": "1.31.0",
    "leaflet": "1.9.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-leaflet": "5.0.0",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxlint": "1.76.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.129.0"
  }
}
